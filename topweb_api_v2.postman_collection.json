    {
      "name": "V2 — Auth",
      "item": [
        {
          "name": "POST login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    pm.test('Login OK — token saved', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);",
                  "} else {",
                  "    pm.test('Login failed — check credentials', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "login"
              ]
            },
            "description": "Authenticates the user and returns a Bearer token.\n\nAvailable users (password: 1234):\n- admin\n- admin1\n- mojarra\n\nThe access_token is automatically saved to {{token}}."
          }
        },
        {
          "name": "GET me (profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has username', () => pm.expect(pm.response.json()).to.have.property('username'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "me"
              ]
            },
            "description": "Returns the authenticated user profile. Requires Bearer token."
          }
        },
        {
          "name": "POST logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', '');",
                  "console.log('Token cleared.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "logout"
              ]
            },
            "description": "Revokes the current Bearer token. Also clears {{token}} locally."
          }
        }
      ]
